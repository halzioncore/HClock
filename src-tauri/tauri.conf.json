{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HClock",
  "version": "1.0.0",
  "identifier": "app.hclock.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HClock - 懂我心意",
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "visible": false
      },
      {
        "label": "widget",
        "title": "HClock 今日课表",
        "url": "index.html?view=widget",
        "width": 348,
        "height": 480,
        "minWidth": 300,
        "minHeight": 320,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false
      },
      {
        "label": "idea",
        "title": "HClock 想法草稿纸",
        "url": "index.html?view=idea",
        "width": 720,
        "height": 680,
        "minWidth": 320,
        "minHeight": 260,
        "resizable": true,
        "center": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
